rule clone_bubblefinder:
    output:
        cmake=os.path.join(BF_SRC, "CMakeLists.txt"),
    shell:
        "git clone --recursive {BF_REPO:q} {BF_SRC:q}"


rule clone_spdlog:
    output:
        cmake=os.path.join(SPDLOG_SRC, "CMakeLists.txt"),
    shell:
        """
        set -euo pipefail
        mkdir -p {TOOLS_DIR:q}
        if [ ! -d {SPDLOG_SRC:q}/.git ]; then
            if [ -e {SPDLOG_SRC:q} ]; then
                [ -d {SPDLOG_SRC:q} ] && [ -z "$(ls -A {SPDLOG_SRC:q})" ] || \
                    {{ echo "Existing non-empty or non-directory path retained" >&2; exit 1; }}
            fi
            git clone --branch v1.15.3 --depth 1 https://github.com/gabime/spdlog.git {SPDLOG_SRC:q}
        fi
        test "$(git -C {SPDLOG_SRC:q} rev-parse HEAD)" = {SPDLOG_COMMIT:q}
        test -f {output.cmake:q}
        """


if os.path.normpath(BF_BIN) == os.path.normpath(os.path.join(BF_SRC, "build/BubbleFinder")):
    rule build_bubblefinder:
        input:
            cmake=os.path.join(BF_SRC, "CMakeLists.txt"),
            spdlog=os.path.join(SPDLOG_SRC, "CMakeLists.txt"),
            sources=[path for base in ("src", "external/clsd", "external/spqr-rust/src",
                                       "external/spqr-rust/include", "external/gbz")
                     for pattern in ("*.cpp", "*.hpp", "*.h", "*.cc", "*.c", "*.rs",
                                     "*.cmake", "*.in", "CMakeLists.txt")
                     for path in glob.glob(os.path.join(BF_SRC, base, "**", pattern), recursive=True)]
                    + glob.glob(os.path.join(BF_SRC, "external/spqr-rust", "Cargo.*"))
                    + glob.glob(os.path.join(BF_SRC, "external/spqr-rust", "rust-toolchain*"))
                    + glob.glob(os.path.join(BF_SRC, "external/spqr-rust", "*.rs"))
                    + glob.glob(os.path.join(SPDLOG_SRC, "include", "**", "*.h"), recursive=True),
        output:
            bin=BF_BIN,
        threads: 4
        resources:
            mem_mb=16000,
            runtime=120,
            cpus_per_task=lambda wc, threads: threads,
        shell:
            """
            set -euo pipefail
            export CC={CC:q}
            export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER={CC:q}
            cmake -S {BF_SRC:q} -B {BF_SRC:q}/build -DCMAKE_BUILD_TYPE=Release \
                -DCMAKE_C_COMPILER={CC:q} \
                -DCMAKE_CXX_COMPILER={CXX:q} \
                -DFETCHCONTENT_SOURCE_DIR_SPDLOG="$(realpath {SPDLOG_SRC:q})"
            (cd {BF_SRC:q}/external/spqr-rust && cargo build --release --manifest-path Cargo.toml)
            cmake --build {BF_SRC:q}/build --target BubbleFinder --parallel {threads}
            test -x {output.bin:q}
            """


rule pin_bubblefinder:
    input:
        bin=BF_BIN,
    output:
        sha=os.path.join(TOOLS_DIR, "paper_bubblefinder.sha256"),
    params:
        expected=config.get("bubblefinder_sha256", ""),
    shell:
        """
        set -euo pipefail
        mkdir -p {TOOLS_DIR:q}
        sha=$(sha256sum {input.bin:q} | cut -d ' ' -f1)
        expected={params.expected:q}
        if [ -n "$expected" ] && [ "$sha" != "$expected" ]; then
            echo "BubbleFinder SHA-256 differs from the configured pin" >&2; exit 1
        fi
        printf '%s\n' "$sha" > {output.sha:q}
        """


rule build_gfa_stats:
    input:
        src="scripts/gfa_stats.cpp",
    output:
        bin=GFA_STATS_BIN,
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bin})
        {CXX:q} -O3 -std=c++17 -o {output.bin} {input.src}
        echo "gfa_stats compiled"
        """

rule install_vg:
    input:
        lock=TOOLCHAIN_LOCK,
    output:
        bin=VG_BIN,
    params:
        version=VG_VERSION,
        url=VG_TOOL["asset_url"],
        sha=VG_TOOL["asset_sha256"],
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bin:q})
        curl -fL -o {output.bin:q}.part {params.url:q}
        echo "{params.sha}  {output.bin}.part" | sha256sum --check
        chmod +x {output.bin:q}.part
        mv {output.bin:q}.part {output.bin:q}
        """


rule clone_billi:
    input:
        lock=TOOLCHAIN_LOCK,
    output:
        stamp=os.path.join(BILLI_SRC, ".cloned"),
    params:
        repo=BILLI_REPO,
        commit=BILLI_COMMIT,
        srcdir=BILLI_SRC,
    shell:
        """
        set -euo pipefail
        mkdir -p {TOOLS_DIR:q}
        if [ ! -d {params.srcdir:q}/.git ]; then
            if [ -e {params.srcdir:q} ]; then
                [ -d {params.srcdir:q} ] && [ -z "$(ls -A {params.srcdir:q})" ] || \
                    {{ echo "Existing non-empty or non-directory path retained" >&2; exit 1; }}
            fi
            git clone {params.repo:q} {params.srcdir:q}
        fi
        git -C {params.srcdir:q} checkout --detach {params.commit:q}
        test "$(git -C {params.srcdir:q} rev-parse HEAD)" = {params.commit:q}
        touch {output.stamp:q}
        """

rule build_billi:
    input:
        stamp=os.path.join(BILLI_SRC, ".cloned"),
        lock=TOOLCHAIN_LOCK,
        recorder="scripts/record_tool_install.py",
    output:
        bin=BILLI_BIN,
        receipt=BILLI_BIN + ".toolchain-install.json",
    params:
        srcdir=BILLI_SRC,
    shell:
        """
        set -euo pipefail
        test "$(git -C {params.srcdir:q} rev-parse HEAD)" = {BILLI_COMMIT:q}
        make -C {params.srcdir:q} CXX={CXX:q} -j${{SLURM_CPUS_PER_TASK:-1}}
        {PYTHON:q} {input.recorder:q} --tool billi --commit {BILLI_COMMIT:q} --executable {output.bin:q}
        """


rule download_zenodo:
    input:
        script="scripts/download_inputs.py",
        datasets="scripts/datasets.py",
        names="config/datasets.tsv",
    output:
        stamp=os.path.join(DATA_DIR, ".zenodo_{record}.done".format(record=ZENODO_RECORD)),
        manifest=os.path.join(DATA_DIR, "zenodo-downloads.json"),
    params:
        directories=" ".join("--directory " + shlex.quote(d) for d in GFA_DIRS),
        jobs=config.get("download_jobs", 4),
        datasets=" ".join("--dataset " + ds for ds in DATASETS),
    shell:
        "{PYTHON:q} {input.script:q} zenodo --data {DATA_DIR:q} --manifest {output.manifest:q} --stamp {output.stamp:q} --record {ZENODO_RECORD:q} --jobs {params.jobs} {params.directories} {params.datasets}"

