TOOL_VARIANTS = config.get("tool_variants", TOOL_VARIANTS)
if "bubblegun" in TOOL_VARIANTS:
    raise ValueError("BubbleGun is excluded from new benchmark comparison manifests")
if any(v in ("d_gfa", "d_gbz") for v in TOOL_VARIANTS):
    raise ValueError("Use the d_bc_gfa and d_bc_gbz result variants for d-bubble benchmarks")

def find_gfa(ds):
    for d in GFA_DIRS:
        p = os.path.join(d, ds + ".gfa")
        if os.path.isfile(p):
            return p
    # If only .gfa.gz exists, return the expected .gfa path
    for d in GFA_DIRS:
        gz = os.path.join(d, ds + ".gfa.gz")
        if os.path.isfile(gz):
            return gz[:-3]  # strip .gz → will exist after decompression
    return os.path.join(DATA_DIR, ds + ".gfa")

def find_gbz(ds):
    for d in GFA_DIRS:
        p = os.path.join(d, ds + ".gbz")
        if os.path.isfile(p):
            return p
    return os.path.join(DATA_DIR, ds + ".gbz") if ds in ("hprc-v1.1-mc-chm13", "hprc-v2.0-mc-chm13", "hprc-v2.1-mc-chm13") else None

def gfa_fmt(_path):
    return "gfa"

def result_files_for(ds, tool):
    R = RESULTS_DIR
    if tool in ("d_bc_gfa", "d_bc_gbz"):
        if tool.endswith("gbz") and find_gbz(ds) is None:
            return []
        return [f"{R}/{ds}.{tool}.receipt.json"]
    if tool in ("vg_gbz_T", "vg_gbz_noT", "bf_gbz_T", "bf_gbz_noT"):
        if find_gbz(ds) is None:
            return []
        return {
            "vg_gbz_T":   [f"{R}/{ds}.vg_gbz.time"],
            "vg_gbz_noT": [f"{R}/{ds}.vg_gbz_noT.time"],
            "bf_gbz_T":   [f"{R}/{ds}.bf_gbz.time"],
            "bf_gbz_noT": [f"{R}/{ds}.bf_gbz_noT.time"],
        }.get(tool, [])
    gfa = find_gfa(ds)
    if gfa is None:
        return []
    fmt = gfa_fmt(gfa)
    R = RESULTS_DIR
    mapping = {
        "vg_gfa_T":   [f"{R}/{ds}.vg_gfa.{fmt}.time"],
        "vg_gfa_noT":  [f"{R}/{ds}.vg_gfa_noT.{fmt}.time"],
        "bf_gfa_T":   [f"{R}/{ds}.bf_gfa.{fmt}.time"],
        "bf_gfa_noT":  [f"{R}/{ds}.bf_gfa_noT.{fmt}.time"],
        "bf_sb_gfa_T": [f"{R}/{ds}.bf_sb_gfa.{fmt}.time"],
        "bf_sb_gfa_noT": [f"{R}/{ds}.bf_sb_gfa_noT.{fmt}.time"],
        "billi":     [f"{R}/{ds}.billi.time"],
        "gfa_stats":  [f"{R}/{ds}.gfa_stats"],
        "vg_stats":   [f"{R}/{ds}.vg_stats"],
    }
    return mapping.get(tool, [])

def all_result_files():
    files = []
    for ds in DATASETS:
        for tool in TOOL_VARIANTS:
            files.extend(result_files_for(ds, tool))
    return [f for f in files if f]


PAPER_DATASETS = config.get("paper_datasets", DATASETS)
PAPER_GBZ = {"hprc-v1.1-mc-chm13", "hprc-v2.0-mc-chm13", "hprc-v2.1-mc-chm13"}
PAPER_THREADS = config.get("paper_threads", [1, 8])
GBZ_MAIN = "hprc-v2.1-mc-chm13"


def paper_input(ds):
    return find_gbz(ds) if ds in PAPER_GBZ else find_gfa(ds)


def paper_ultrabubble_time(ds):
    if ds == "hprc-v2.1-mc-chm13":
        return os.path.join(RESULTS_DIR, ds + ".bf_gbz.time")
    return os.path.join(RESULTS_DIR, ds + ".bf_gfa.gfa.time")


def paper_ultrabubble_nontrivial(ds):
    if ds == "hprc-v2.1-mc-chm13":
        return os.path.join(RESULTS_DIR, ds + ".bf_gbz_noT.txt")
    return os.path.join(RESULTS_DIR, ds + ".bf_gfa_noT.gfa.txt")


def paper_ultrabubble_nontrivial_time(ds):
    return paper_ultrabubble_nontrivial(ds)[:-len(".txt")] + ".time"


def paper_vg_counts(ds, all_records):
    if ds == "hprc-v2.1-mc-chm13":
        return os.path.join(RESULTS_DIR, ds + (".vg_gbz.snarl_counts" if all_records else ".vg_gbz_noT.snarl_counts"))
    return os.path.join(RESULTS_DIR, ds + (".vg_gfa.gfa.snarl_counts" if all_records else ".vg_gfa_noT.gfa.snarl_counts"))


def paper_vg_catalogue_path(ds, suffix):
    stem = ".vg_gbz" if ds == "hprc-v2.1-mc-chm13" else ".vg_gfa.gfa"
    return os.path.join(RESULTS_DIR, ds + stem + suffix)


def paper_d_catalogue_path(ds, suffix):
    if ds == "hprc-v2.1-mc-chm13":
        return os.path.join(PAPER_DIR, ds + ".d.1" + suffix)
    return os.path.join(RESULTS_DIR, ds + ".d_bc_gfa" + suffix)


def paper_gfa_memory(ds):
    if ds in {"hprc-v2.0-mc-chm13", "hprc-v2.1-mc-chm13"}:
        return 1800000
    if ds == "hprc-v1.1-mc-chm13":
        return 600000
    if DATASET_INFO.get(ds, {}).get("group") == "Pangene":
        return 16000
    return 180000


