rule generate_tables:
    input:
        lock=TOOLCHAIN_LOCK,
        ready=DATA_READY,
        results=all_result_files(),
        script="scripts/make_table.py",
        guard="scripts/toolchain_provenance.py",
    output:
        bubble=os.path.join(TABLES_DIR, "bubble_table.tex"),
        gfa=os.path.join(TABLES_DIR, "gfa_table.tex"),
        stats=os.path.join(TABLES_DIR, "graph_stats_table.tex"),
        bench=os.path.join(TABLES_DIR, "bench_table.tex"),
        tsv=os.path.join(TABLES_DIR, "bench_summary.tsv"),
    shell:
        "{PYTHON:q} {input.guard:q} check-results --lock {input.lock:q} --results {RESULTS_DIR:q} && mkdir -p {TABLES_DIR:q} && {PYTHON:q} {input.script:q} {RESULTS_DIR:q} {TABLES_DIR:q}"

rule tables_only:
    """Regenerate only active d-bubble tables from available verified results."""
    input:
        lock=TOOLCHAIN_LOCK,
        script="scripts/d_table.py",
    output:
        touch(os.path.join(TABLES_DIR, ".tables_only.done")),
    shell:
        "mkdir -p {TABLES_DIR:q} && {PYTHON:q} {input.script:q} {RESULTS_DIR:q} {TABLES_DIR:q} --stem d_bubble_comparison --toolchain-lock {input.lock:q}"


rule run_vg_gfa_T:
    input:
        benchmark_wrapper=BENCH_WRAPPER,
        measurement_provenance="scripts/toolchain_provenance.py",
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        lock=TOOLCHAIN_LOCK,
        bin=VG_BIN,
    output:
        time=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.time"),
        provenance=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.time") + ".toolchain.json",
        pb=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.snarls.pb"),
        log=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.log"),
        bubbles=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.pairs"),
        ub_bubbles=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.ub.pairs"),
        counts=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.snarl_counts"),
        ub_count=os.path.join(RESULTS_DIR, "{ds}.vg_gfa.{fmt}.ub"),
    wildcard_constraints:
        fmt="gfa",
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds),
        runtime=1440,
    params:
        gfa=lambda wc: find_gfa(wc.ds),
        R=RESULTS_DIR,
        tsec=lambda wc: timeout_sec("vg_gfa_T"),
    shell:
        """
        set -euo pipefail
        [ ! -f "{params.gfa}" ] && [ -f "{params.gfa}.gz" ] && gunzip -k "{params.gfa}.gz" || true
        ds="{wildcards.ds}"; fmt="{wildcards.fmt}"; R="{params.R}"
        mkdir -p "$R"
        scratch=$(mktemp -d {BENCH_TMPFS:q}/paper-vg-catalogue.XXXXXXXX)
        trap 'rm -rf "$scratch"' EXIT
        staged="$scratch/$(basename {params.gfa:q})"
        cp {params.gfa:q} "$staged"
        cmp -s {params.gfa:q} "$staged"
        graph_sha=$({PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q} --print-sha256)
        BENCH_GRAPH_SHA256="$graph_sha" BENCH_PYTHON={PYTHON:q} BENCH_TOOLCHAIN_LOCK={input.lock:q} BENCH_TOOLCHAIN_TOOL=vg BENCH_TOOLCHAIN_EXE={VG_BIN:q} bash {BENCH_WRAPPER} {TIME_BIN} {params.tsec} {output.time} \
            "{input.bin} snarls -T -A integrated -t 1 '$staged' > '$scratch/snarls.pb' 2> '$scratch/vg.log'"
        cp "$scratch/snarls.pb" {output.pb:q}
        cp "$scratch/vg.log" {output.log:q}
        if grep -q "^EXIT_CODE=" {output.time:q}; then
            echo "vg failed; its output cannot be used for comparisons" >&2
            exit 1
        fi
        {input.bin:q} view -R -j {output.pb:q} | {PYTHON:q} scripts/bubbles.py vg \
            --bubbles {output.bubbles:q} --ub-bubbles {output.ub_bubbles:q} --counts {output.counts:q}
        grep '^n_ub' {output.counts:q} > {output.ub_count:q}
        """

rule run_vg_gfa_noT:
    input:
        benchmark_wrapper=BENCH_WRAPPER,
        measurement_provenance="scripts/toolchain_provenance.py",
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        lock=TOOLCHAIN_LOCK,
        bin=VG_BIN,
    output:
        time=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.time"),
        provenance=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.time") + ".toolchain.json",
        pb=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.snarls.pb"),
        log=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.log"),
        bubbles=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.pairs"),
        counts=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.snarl_counts"),
        ub_count=os.path.join(RESULTS_DIR, "{ds}.vg_gfa_noT.{fmt}.ub"),
    wildcard_constraints:
        fmt="gfa",
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds),
        runtime=1440,
    params:
        gfa=lambda wc: find_gfa(wc.ds),
        R=RESULTS_DIR,
        tsec=lambda wc: timeout_sec("vg_gfa_noT"),
    shell:
        """
        set -euo pipefail
        [ ! -f "{params.gfa}" ] && [ -f "{params.gfa}.gz" ] && gunzip -k "{params.gfa}.gz" || true
        ds="{wildcards.ds}"; fmt="{wildcards.fmt}"; R="{params.R}"
        mkdir -p "$R"
        scratch=$(mktemp -d {BENCH_TMPFS:q}/paper-vg-catalogue.XXXXXXXX)
        trap 'rm -rf "$scratch"' EXIT
        staged="$scratch/$(basename {params.gfa:q})"
        cp {params.gfa:q} "$staged"
        cmp -s {params.gfa:q} "$staged"
        graph_sha=$({PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q} --print-sha256)
        BENCH_GRAPH_SHA256="$graph_sha" BENCH_PYTHON={PYTHON:q} BENCH_TOOLCHAIN_LOCK={input.lock:q} BENCH_TOOLCHAIN_TOOL=vg BENCH_TOOLCHAIN_EXE={VG_BIN:q} bash {BENCH_WRAPPER} {TIME_BIN} {params.tsec} {output.time} \
            "{input.bin} snarls -A integrated -t 1 '$staged' > '$scratch/snarls.pb' 2> '$scratch/vg.log'"
        cp "$scratch/snarls.pb" {output.pb:q}
        cp "$scratch/vg.log" {output.log:q}
        if grep -q '^EXIT_CODE=' {output.time:q}; then echo "vg failed; no catalogue" >&2; exit 1; fi
        {input.bin:q} view -R -j {output.pb:q} | {PYTHON:q} scripts/bubbles.py vg \
            --bubbles {output.bubbles:q} --counts {output.counts:q}
        grep '^n_ub' {output.counts:q} > {output.ub_count:q}
        """

rule run_bf_gfa_T:
    input:
        benchmark_wrapper=BENCH_WRAPPER,
        measurement_provenance="scripts/toolchain_provenance.py",
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        lock=TOOLCHAIN_LOCK,
        bin=BF_BIN,
    output:
        time=os.path.join(RESULTS_DIR, "{ds}.bf_gfa.{fmt}.time"),
        provenance=os.path.join(RESULTS_DIR, "{ds}.bf_gfa.{fmt}.time") + ".toolchain.json",
        bubbles=os.path.join(RESULTS_DIR, "{ds}.bf_gfa.{fmt}.txt"),
        log=os.path.join(RESULTS_DIR, "{ds}.bf_gfa.{fmt}.log"),
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds),
        runtime=720,
    params:
        gfa=lambda wc: find_gfa(wc.ds),
        R=RESULTS_DIR,
        tsec=lambda wc: timeout_sec("bf_gfa_T"),
    shell:
        """
        set -euo pipefail
        [ ! -f "{params.gfa}" ] && [ -f "{params.gfa}.gz" ] && gunzip -k "{params.gfa}.gz" || true
        ds="{wildcards.ds}"; fmt="{wildcards.fmt}"; R="{params.R}"
        mkdir -p "$R"
        scratch=$(mktemp -d {BENCH_TMPFS:q}/paper-bf-u.XXXXXXXX)
        trap 'rm -rf "$scratch"' EXIT
        staged="$scratch/$(basename {params.gfa:q})"
        cp {params.gfa:q} "$staged"
        cmp -s {params.gfa:q} "$staged"
        graph_sha=$({PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q} --print-sha256)
        BENCH_GRAPH_SHA256="$graph_sha" BENCH_PYTHON={PYTHON:q} BENCH_TOOLCHAIN_LOCK={input.lock:q} BENCH_TOOLCHAIN_TOOL=bubblefinder BENCH_TOOLCHAIN_EXE={BF_BIN:q} bash {BENCH_WRAPPER} {TIME_BIN} {params.tsec} {output.time} \
            "{input.bin} ultrabubbles -T -g '$staged' -o '$scratch/bubbles.txt' -j 1 -m {BF_STACK} > '$scratch/bf.log' 2>&1"
        cp "$scratch/bf.log" {output.log:q}
        if ! grep -q '^EXIT_CODE=' {output.time:q}; then cp "$scratch/bubbles.txt" {output.bubbles:q}; else : > {output.bubbles:q}; fi
        """

