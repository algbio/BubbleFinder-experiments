rule paper_validation_no_external:
    input:
        admission=INPUT_ADMISSION,
        prior_comparisons=[config["validation_prior_comparisons"]] if config.get("validation_prior_comparisons") else [],
        lock=TOOLCHAIN_LOCK,
        main_d=[paper_d_catalogue_path(ds, ".receipt.json") for ds in PAPER_DATASETS],
        d=expand(os.path.join(PAPER_DIR, "{ds}.d.{jobs}.receipt.json"), ds=PAPER_DATASETS, jobs=[1, 8]),
        consistent=expand(os.path.join(PAPER_DIR, "{ds}.thread-consistency.json"), ds=PAPER_DATASETS),
        u=expand(os.path.join(PAPER_DIR, "{ds}.u.1.receipt.json"), ds=PAPER_DATASETS),
        nontrivial=expand(os.path.join(PAPER_DIR, "{ds}.validation-nontrivial.receipt.json"), ds=PAPER_DATASETS),
        sizes=expand(os.path.join(PAPER_DIR, "{ds}.quartiles.tsv"), ds=PAPER_DATASETS),
        topology=expand(os.path.join(RESULTS_DIR, "{ds}.gfa_stats"), ds=PAPER_DATASETS),
        ultrabubble_times=[paper_ultrabubble_time(ds) for ds in PAPER_DATASETS],
        ultrabubble_all=[paper_ultrabubble_time(ds).replace(".time", ".txt") for ds in PAPER_DATASETS],
        ultrabubble_log=[paper_ultrabubble_time(ds).replace(".time", ".log") for ds in PAPER_DATASETS],
        ultrabubble_nontrivial=[paper_ultrabubble_nontrivial(ds) for ds in PAPER_DATASETS],
        ultrabubble_provenance=[paper_ultrabubble_time(ds) + ".toolchain.json" for ds in PAPER_DATASETS],
        ultrabubble_nontrivial_times=[paper_ultrabubble_nontrivial_time(ds) for ds in PAPER_DATASETS],
        ultrabubble_nontrivial_provenance=[paper_ultrabubble_nontrivial_time(ds) + ".toolchain.json" for ds in PAPER_DATASETS],
        bin_sha=os.path.join(TOOLS_DIR, "paper_bubblefinder.sha256"),
        script="scripts/paper_validation_summary.py",
        prior_overlaps="scripts/paper_prior_overlaps.py",
        catalogue="scripts/paper_catalogues.py",
        venn="scripts/paper_venn.py",
        renderer="scripts/paper_tables.py",
        datasets="scripts/datasets.py",
        names="config/datasets.tsv",
        diagrams="scripts/paper_validation_diagrams.py",
        template="templates/paper-tables.tex",
    output:
        tsv=os.path.join(TABLES_DIR, "validation-no-vg-billi", "paper-results.tsv"),
        latex=os.path.join(TABLES_DIR, "validation-no-vg-billi", "paper-results.tex"),
        report=os.path.join(TABLES_DIR, "validation-no-vg-billi", "validation.json"),
        overlaps=os.path.join(TABLES_DIR, "validation-no-vg-billi", "figures", "overlaps.tex"),
        four_set=os.path.join(TABLES_DIR, "validation-no-vg-billi", "figures", "four-set.tex"),
    params:
        datasets=" ".join("--dataset " + shlex.quote(ds) for ds in PAPER_DATASETS),
        existing_results=config.get("validation_existing_results", RESULTS_DIR),
        prior_flag=("--prior-comparisons " + shlex.quote(config["validation_prior_comparisons"])
                    if config.get("validation_prior_comparisons") else ""),
    shell:
        """
        mkdir -p "$(dirname {output.tsv:q})"
        {PYTHON:q} {input.script:q} --results {RESULTS_DIR:q} --paper {PAPER_DIR:q} \
            --existing-results {params.existing_results:q} --admission {input.admission:q} \
            {params.prior_flag} \
            --tmpdir {BENCH_TMPFS:q} \
            --toolchain-lock {input.lock:q} --binary-sha {input.bin_sha:q} \
            --template {input.template:q} --output {output.tsv:q} --latex {output.latex:q} \
            --report {output.report:q} {params.datasets}
        {PYTHON:q} {input.diagrams:q} --results {output.tsv:q} --report {output.report:q} \
            --overlaps {output.overlaps:q} --four-set {output.four_set:q}
        """


rule paper_vg_threads:
    input:
        benchmark_wrapper=BENCH_WRAPPER,
        measurement_provenance="scripts/toolchain_provenance.py",
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        lock=TOOLCHAIN_LOCK,
        bin=VG_BIN,
    output:
        time=os.path.join(PAPER_DIR, "{ds}.vg.{jobs}.time"),
        provenance=os.path.join(PAPER_DIR, "{ds}.vg.{jobs}.time") + ".toolchain.json",
        log=os.path.join(PAPER_DIR, "{ds}.vg.{jobs}.log"),
    wildcard_constraints:
        jobs="[1-9][0-9]*",
    threads: lambda wc: int(wc.jobs)
    resources:
        mem_mb=lambda wc: 180000 if wc.ds in PAPER_GBZ else paper_gfa_memory(wc.ds),
        runtime=720,
        cpus_per_task=lambda wc, threads: threads,
    params:
        graph=lambda wc: paper_input(wc.ds),
        tsec=lambda wc: timeout_sec("vg_gbz_T" if wc.ds in PAPER_GBZ else "vg_gfa_T"),
    shell:
        """
        set -euo pipefail
        [ {threads} = {wildcards.jobs} ] || {{ echo "Allocate {wildcards.jobs} CPUs for this measurement" >&2; exit 1; }}
        mkdir -p {PAPER_DIR:q}
        scratch=$(mktemp -d {BENCH_TMPFS:q}/paper-vg.XXXXXXXX)
        trap 'rm -rf "$scratch"' EXIT
        staged="$scratch/$(basename {params.graph:q})"
        cp {params.graph:q} "$staged"
        cmp -s {params.graph:q} "$staged"
        graph_sha=$({PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.graph:q} --print-sha256)
        BENCH_GRAPH_SHA256="$graph_sha" BENCH_PYTHON={PYTHON:q} BENCH_TOOLCHAIN_LOCK={input.lock:q} BENCH_TOOLCHAIN_TOOL=vg BENCH_TOOLCHAIN_EXE={input.bin:q} \
            bash {BENCH_WRAPPER:q} {TIME_BIN:q} {params.tsec} {output.time:q} \
            "{input.bin} snarls -T -A integrated -t {threads} '$staged' > '$scratch/snarls.pb' 2> '$scratch/vg.log'"
        cp "$scratch/vg.log" {output.log:q}
        """


rule paper_summary:
    input:
        physical=expand(os.path.join(PAPER_DIR, "{ds}.physical.tsv"), ds=PAPER_DATASETS),
        sizes=expand(os.path.join(PAPER_DIR, "{ds}.quartiles.tsv"), ds=PAPER_DATASETS),
        overlaps=expand(os.path.join(PAPER_DIR, "{ds}.overlaps.tsv"), ds=PAPER_DATASETS),
        classifications=expand(os.path.join(PAPER_DIR, "{ds}.classification.json"), ds=PAPER_DATASETS),
        billi=expand(os.path.join(PAPER_DIR, "{ds}.billi.pairs.json"), ds=PAPER_DATASETS),
        billi_times=expand(os.path.join(RESULTS_DIR, "{ds}.billi.time"), ds=PAPER_DATASETS),
        billi_logs=expand(os.path.join(RESULTS_DIR, "{ds}.billi.log"), ds=PAPER_DATASETS),
        billi_counts=expand(os.path.join(RESULTS_DIR, "{ds}.billi.counts"), ds=PAPER_DATASETS),
        vg_counts=[paper_vg_counts(ds, True) for ds in PAPER_DATASETS],
        vg_nontrivial_counts=[paper_vg_counts(ds, False) for ds in PAPER_DATASETS],
        vg_gfa_times=expand(os.path.join(RESULTS_DIR, "{ds}.vg_gfa.gfa.time"), ds=PAPER_DATASETS),
        topology=expand(os.path.join(RESULTS_DIR, "{ds}.gfa_stats"), ds=PAPER_DATASETS),
        ultrabubble_times=[paper_ultrabubble_time(ds) for ds in PAPER_DATASETS],
        ultrabubble_all=[paper_ultrabubble_time(ds).replace(".time", ".txt") for ds in PAPER_DATASETS],
        ultrabubble_log=[paper_ultrabubble_time(ds).replace(".time", ".log") for ds in PAPER_DATASETS],
        ultrabubble_nontrivial=[paper_ultrabubble_nontrivial(ds) for ds in PAPER_DATASETS],
        d_gfa=[paper_d_catalogue_path(ds, ".receipt.json") for ds in PAPER_DATASETS],
        d=expand(os.path.join(PAPER_DIR, "{ds}.d.{jobs}.receipt.json"), ds=PAPER_DATASETS, jobs=PAPER_THREADS),
        thread_consistency=expand(os.path.join(PAPER_DIR, "{ds}.thread-consistency.json"), ds=PAPER_DATASETS),
        u=expand(os.path.join(PAPER_DIR, "{ds}.u.1.receipt.json"), ds=PAPER_DATASETS),
        vg=expand(os.path.join(PAPER_DIR, "{ds}.vg.{jobs}.time"), ds=PAPER_DATASETS, jobs=PAPER_THREADS),
        lock=TOOLCHAIN_LOCK,
        admission=INPUT_ADMISSION,
        admission_script="scripts/check_admitted_input.py",
        provenance_script="scripts/toolchain_provenance.py",
        billi_provenance=expand(os.path.join(RESULTS_DIR, "{ds}.billi.time.toolchain.json"), ds=PAPER_DATASETS),
        vg_all_provenance=[paper_vg_counts(ds, True).replace(".snarl_counts", ".time.toolchain.json") for ds in PAPER_DATASETS],
        vg_nontrivial_provenance=[paper_vg_counts(ds, False).replace(".snarl_counts", ".time.toolchain.json") for ds in PAPER_DATASETS],
        vg_gfa_provenance=expand(os.path.join(RESULTS_DIR, "{ds}.vg_gfa.gfa.time.toolchain.json"), ds=PAPER_DATASETS),
        ultrabubble_provenance=[paper_ultrabubble_time(ds) + ".toolchain.json" for ds in PAPER_DATASETS],
        ultrabubble_nontrivial_times=[paper_ultrabubble_nontrivial_time(ds) for ds in PAPER_DATASETS],
        ultrabubble_nontrivial_provenance=[paper_ultrabubble_nontrivial_time(ds) + ".toolchain.json" for ds in PAPER_DATASETS],
        vg_thread_provenance=expand(os.path.join(PAPER_DIR, "{ds}.vg.{jobs}.time.toolchain.json"), ds=PAPER_DATASETS, jobs=PAPER_THREADS),
        script="scripts/paper_summary.py",
        table_renderer="scripts/paper_tables.py",
        datasets="scripts/datasets.py",
        names="config/datasets.tsv",
        table_template="templates/paper-tables.tex",
    output:
        tsv=os.path.join(TABLES_DIR, "paper-results.tsv"),
        latex=os.path.join(TABLES_DIR, "paper-results.tex"),
    params:
        datasets=" ".join("--dataset " + shlex.quote(ds) for ds in PAPER_DATASETS),
        threads=" ".join("--threads " + str(int(j)) for j in PAPER_THREADS),
    shell:
        """
        mkdir -p {TABLES_DIR:q}
        {PYTHON:q} {input.script:q} --results {RESULTS_DIR:q} --paper {PAPER_DIR:q} \
            --output {output.tsv:q} --latex {output.latex:q} --table-template {input.table_template:q} \
            --toolchain-lock {input.lock:q} --admission {input.admission:q} {params.datasets} {params.threads}
        """


