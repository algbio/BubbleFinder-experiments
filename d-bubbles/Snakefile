rule paper_billi_nontrivial:
    input:
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        bin=os.path.join(TOOLS_DIR, "paper_billi_filter"),
        bubbles=os.path.join(PAPER_DIR, "{ds}.billi.pairs.tsv"),
        vg=os.path.join(PAPER_DIR, "{ds}.vg.nontrivial.tsv"),
        status=os.path.join(PAPER_DIR, "{ds}.billi.pairs.json"),
    output:
        bubbles=os.path.join(PAPER_DIR, "{ds}.billi.nontrivial.tsv"),
        summary=os.path.join(PAPER_DIR, "{ds}.billi.physical.tsv"),
        outside=os.path.join(PAPER_DIR, "{ds}.billi.outside-vg.tsv"),
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds),
        runtime=720,
    params:
        gfa=lambda wc: find_gfa(wc.ds),
    shell:
        """
        set -euo pipefail
        status=$({PYTHON:q} -c 'import json,sys; print(json.load(open(sys.argv[1]))["status"])' {input.status:q})
        if [ "$status" = failed ]; then
            : > {output.bubbles:q}
            printf 'x\ty\tsnarl\n' > {output.outside:q}
            printf 'metric\tvalue\nstatus\tfailed\n' > {output.summary:q}
        elif [ "$status" = ok ]; then
            {PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q}
            {input.bin:q} {params.gfa:q} {input.bubbles:q} {input.vg:q} {output.bubbles:q} {output.outside:q} > {output.summary:q}
            {PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q}
        else
            echo "Unknown Billi status: $status" >&2; exit 1
        fi
        """


