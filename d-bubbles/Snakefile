        summary=os.path.join(TABLES_DIR, "d_bubble_comparison.tsv"),
        performance=os.path.join(TABLES_DIR, "d_bubble_comparison-performance.tex"),
    shell:
        "mkdir -p {TABLES_DIR} && {PYTHON:q} {input.script} {RESULTS_DIR} {TABLES_DIR} --stem d_bubble_comparison --toolchain-lock {input.lock:q}"


