rule run_billi:
    input:
        benchmark_wrapper=BENCH_WRAPPER,
        measurement_provenance="scripts/toolchain_provenance.py",
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        lock=TOOLCHAIN_LOCK,
        bin=BILLI_BIN,
        install_receipt=BILLI_BIN + ".toolchain-install.json",
        parser="scripts/parse_billi.py",
    output:
        time=os.path.join(RESULTS_DIR, "{ds}.billi.time"),
        provenance=os.path.join(RESULTS_DIR, "{ds}.billi.time") + ".toolchain.json",
        log=os.path.join(RESULTS_DIR, "{ds}.billi.log"),
        rows=os.path.join(RESULTS_DIR, "{ds}.billi.txt"),
        counts=os.path.join(RESULTS_DIR, "{ds}.billi.counts"),
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds),
        runtime=720,
    params:
        gfa=lambda wc: find_gfa(wc.ds),
        R=RESULTS_DIR,
        tsec=lambda wc: timeout_sec("billi"),
    shell:
        """
        set -euo pipefail
        [ ! -f "{params.gfa}" ] && [ -f "{params.gfa}.gz" ] && gunzip -k "{params.gfa}.gz" || true
        ds="{wildcards.ds}"; R="{params.R}"
        mkdir -p "$R"
        scratch=$(mktemp -d {BENCH_TMPFS:q}/paper-billi.XXXXXXXX)
        trap 'rm -rf "$scratch"' EXIT
        staged="$scratch/$(basename {params.gfa:q})"
        cp {params.gfa:q} "$staged"
        cmp -s {params.gfa:q} "$staged"
        graph_sha=$({PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q} --print-sha256)
        BENCH_GRAPH_SHA256="$graph_sha" BENCH_PYTHON={PYTHON:q} BENCH_TOOLCHAIN_LOCK={input.lock:q} BENCH_TOOLCHAIN_TOOL=billi BENCH_TOOLCHAIN_EXE={BILLI_BIN:q} bash {BENCH_WRAPPER} {TIME_BIN} {params.tsec} {output.time} \
            "{input.bin} decompose -w -i '$staged' > '$scratch/billi.log' 2>&1"
        cp "$scratch/billi.log" {output.log:q}
        if ! grep -q "^EXIT_CODE=" {output.time}; then
            {PYTHON:q} {input.parser:q} {output.log:q} --rows {output.rows:q} --counts {output.counts:q}
        else
            : > {output.rows:q}
            printf 'status\tfailed\n' > {output.counts:q}
        fi
        """

rule run_gfa_stats:
    input:
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        guard="scripts/check_admitted_input.py",
        bin=GFA_STATS_BIN,
    output:
        stats=os.path.join(RESULTS_DIR, "{ds}.gfa_stats"),
        empty=os.path.join(RESULTS_DIR, "{ds}.empty.pairs"),
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds),
        runtime=720,
    params:
        gfa=lambda wc: find_gfa(wc.ds),
        tsec=lambda wc: timeout_sec("gfa_stats"),
    shell:
        """
        set -euo pipefail
        [ ! -f "{params.gfa}" ] && [ -f "{params.gfa}.gz" ] && gunzip -k "{params.gfa}.gz" || true
        {PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q}
        TMP="{output.stats}.tmp"
        rm -f "$TMP"
        {input.bin} "{params.gfa}" "{output.empty}" > "$TMP" 2>/dev/null
        {PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gfa:q}
        mv "$TMP" {output.stats}
        """

rule compute_vg_stats:
    input:
        ready=DATA_READY,
        bin=VG_BIN,
    output:
        stats=os.path.join(RESULTS_DIR, "{ds}.vg_stats"),
    params:
        gfa=lambda wc: find_gfa(wc.ds),
        tsec=lambda wc: timeout_sec("gfa_stats"),
    shell:
        """
        set -euo pipefail
        [ ! -f "{params.gfa}" ] && [ -f "{params.gfa}.gz" ] && gunzip -k "{params.gfa}.gz" || true
        TMP="{output.stats}.tmp"
        rm -f "$TMP"
        {input.bin} stats -N -E "{params.gfa}" 2>/dev/null \
            | paste <(printf "nodes\\nedges") - > "$TMP"
        mv "$TMP" {output.stats}
        """

