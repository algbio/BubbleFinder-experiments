        bin=BF_BIN,
    output:
        time=os.path.join(RESULTS_DIR, "{ds}.bf_gbz_noT.time"),
        provenance=os.path.join(RESULTS_DIR, "{ds}.bf_gbz_noT.time") + ".toolchain.json",
        bubbles=os.path.join(RESULTS_DIR, "{ds}.bf_gbz_noT.txt"),
        log=os.path.join(RESULTS_DIR, "{ds}.bf_gbz_noT.log"),
    params:
        gbz=lambda wc: find_gbz(wc.ds),
        R=RESULTS_DIR,
        tsec=lambda wc: timeout_sec("bf_gbz_noT"),
    shell:
        """
        set -euo pipefail
        ds="{wildcards.ds}"; R="{params.R}"
        mkdir -p "$R"
        scratch=$(mktemp -d {BENCH_TMPFS:q}/paper-bf-u.XXXXXXXX)
        trap 'rm -rf "$scratch"' EXIT
        staged="$scratch/$(basename {params.gbz:q})"
        cp {params.gbz:q} "$staged"
        cmp -s {params.gbz:q} "$staged"
        graph_sha=$({PYTHON:q} {input.guard:q} --admission {input.admission:q} --graph {params.gbz:q} --print-sha256)
        BENCH_GRAPH_SHA256="$graph_sha" BENCH_PYTHON={PYTHON:q} BENCH_TOOLCHAIN_LOCK={input.lock:q} BENCH_TOOLCHAIN_TOOL=bubblefinder BENCH_TOOLCHAIN_EXE={BF_BIN:q} bash {BENCH_WRAPPER} {TIME_BIN} {params.tsec} {output.time} \
            "{input.bin} ultrabubbles -g '$staged' -o '$scratch/bubbles.txt' -j 1 -m {BF_STACK} > '$scratch/bf.log' 2>&1"
        cp "$scratch/bf.log" {output.log:q}
        if grep -q '^EXIT_CODE=' {output.time:q}; then echo "BubbleFinder ultrabubbles failed" >&2; exit 1; fi
        cp "$scratch/bubbles.txt" {output.bubbles:q}
        """

rule run_d_bubbles:
    input:
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        bin=BF_BIN,
        bin_sha=os.path.join(TOOLS_DIR, "paper_bubblefinder.sha256"),
        script="scripts/run_d.py",
    output:
        receipt=os.path.join(RESULTS_DIR, "{ds}.{variant}.receipt.json"),
        bubbles=os.path.join(RESULTS_DIR, "{ds}.{variant}.tsv"),
        stdout=os.path.join(RESULTS_DIR, "{ds}.{variant}.stdout"),
        stderr=os.path.join(RESULTS_DIR, "{ds}.{variant}.stderr"),
    wildcard_constraints:
        variant="d_bc_gfa|d_bc_gbz",
    threads: 1
    resources:
        mem_mb=lambda wc: paper_gfa_memory(wc.ds) if wc.variant.endswith("gfa") else 180000,
        runtime=720,
    params:
        graph=lambda wc: find_gbz(wc.ds) if wc.variant.endswith("gbz") else find_gfa(wc.ds),
        prefix=lambda wc: os.path.join(RESULTS_DIR, wc.ds + "." + wc.variant),
    shell:
        """
        {PYTHON:q} {input.script:q} --binary {input.bin:q} --graph {params.graph:q} \
            --prefix {params.prefix:q} --expected-sha256 "$(cat {input.bin_sha:q})" \
            --threads {threads} --tmpfs {BENCH_TMPFS:q} --admission {input.admission:q}
        """

