rule paper_bubblefinder_threads:
    input:
        ready=DATA_READY,
        admission=INPUT_ADMISSION,
        bin=BF_BIN,
        bin_sha=os.path.join(TOOLS_DIR, "paper_bubblefinder.sha256"),
        script="scripts/run_d.py",
    output:
        receipt=os.path.join(PAPER_DIR, "{ds}.{mode}.{jobs}.receipt.json"),
        bubbles=os.path.join(PAPER_DIR, "{ds}.{mode}.{jobs}.tsv"),
        stdout=os.path.join(PAPER_DIR, "{ds}.{mode}.{jobs}.stdout"),
        stderr=os.path.join(PAPER_DIR, "{ds}.{mode}.{jobs}.stderr"),
    wildcard_constraints:
        mode="d|u",
        jobs="[1-9][0-9]*",
    threads: lambda wc: int(wc.jobs)
    resources:
        mem_mb=lambda wc: 180000 if (wc.mode == "d" and wc.ds in PAPER_GBZ) or wc.ds == "hprc-v2.1-mc-chm13" else paper_gfa_memory(wc.ds),
        runtime=720,
        cpus_per_task=lambda wc, threads: threads,
    params:
        graph=lambda wc: paper_input(wc.ds) if wc.mode == "d" or wc.ds == "hprc-v2.1-mc-chm13" else find_gfa(wc.ds),
        prefix=lambda wc: os.path.join(PAPER_DIR, wc.ds + "." + wc.mode + "." + wc.jobs),
        flags=lambda wc: "--ultrabubbles-only" if wc.mode == "u" else "",
    shell:
        """
        set -euo pipefail
        [ {threads} = {wildcards.jobs} ] || {{ echo "Allocate {wildcards.jobs} CPUs for this measurement" >&2; exit 1; }}
        {PYTHON:q} {input.script:q} --binary {input.bin:q} --graph {params.graph:q} --prefix {params.prefix:q} \
            --expected-sha256 "$(cat {input.bin_sha:q})" --threads {threads} --tmpfs {BENCH_TMPFS:q} --admission {input.admission:q} {params.flags}
        """


rule paper_thread_consistency:
    input:
        bubbles=expand(os.path.join(PAPER_DIR, "{{ds}}.d.{jobs}.tsv"), jobs=PAPER_THREADS),
        receipts=expand(os.path.join(PAPER_DIR, "{{ds}}.d.{jobs}.receipt.json"), jobs=PAPER_THREADS),
        reference=lambda wc: paper_d_catalogue_path(wc.ds, ".tsv"),
        reference_receipt=lambda wc: paper_d_catalogue_path(wc.ds, ".receipt.json"),
        script="scripts/paper_thread_consistency.py",
    output:
        os.path.join(PAPER_DIR, "{ds}.thread-consistency.json"),
    params:
        samples=lambda wc: " ".join("--sample " + shlex.quote(str(int(j)) + "=" +
            os.path.join(PAPER_DIR, wc.ds + ".d." + str(int(j)) + ".tsv")) for j in PAPER_THREADS),
        receipts=lambda wc: " ".join("--receipt " + shlex.quote(str(int(j)) + "=" +
            os.path.join(PAPER_DIR, wc.ds + ".d." + str(int(j)) + ".receipt.json")) for j in PAPER_THREADS),
    shell:
        """
        {PYTHON:q} {input.script:q} --dataset {wildcards.ds:q} {params.samples} {params.receipts} \
            --reference {input.reference:q} --reference-receipt {input.reference_receipt:q} --output {output:q}
        """


